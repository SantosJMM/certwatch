# Certificate discovery. Values are parsed as plain text; do not source this file in a shell.
CERTBOT_LIVE_DIR=/etc/letsencrypt/live
CERTWATCH_RENEWAL_DIR=/etc/letsencrypt/renewal
CERTWATCH_STATE_DIR=/var/lib/certwatch
CERTWATCH_CONFIG_PATH=/etc/certwatch/certwatch.env
CERTWATCH_ACTION_LOG=/var/log/certwatch/actions.log
CERTWATCH_AGENT_STATE_DIR=/var/lib/certwatch-agent
CERTWATCH_ACTION_HELPER=/usr/local/libexec/certwatch-action

# Server identity and certificate thresholds.
SERVER_ID=
SERVER_LABEL=
WARN_DAYS=30
CRITICAL_DAYS=7
CERT_INCLUDE=
CERT_EXCLUDE=
CERTWATCH_ENDPOINTS=
CERTWATCH_REQUEST_TIMEOUT_SECONDS=15

# Notification adapters. Leave disabled until each provider is configured.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=<telegram-bot-token>
TELEGRAM_CHAT_ID=<telegram-chat-id>
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=<gmail-user>
SMTP_FROM=<from-address>
SMTP_TO=<recipient-address>
SMTP_APP_PASSWORD=<gmail-app-password>

# Telegram command agent. Keep false until allowlists are complete.
TELEGRAM_AGENT_ENABLED=false
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_CONFIRM_TTL_SECONDS=300
TELEGRAM_POLL_TIMEOUT_SECONDS=30
TELEGRAM_COMMANDS=status,check,certs,service,renew,restart
